# ─────────────────────────────────────────────────────────────────────────────
# local.properties.example
#
# Este archivo es una PLANTILLA. Copialo como local.properties y completá
# los valores con tus credenciales reales. NUNCA commitees local.properties.
#
# Uso:
#   cp local.properties.example local.properties
#
# ─────────────────────────────────────────────────────────────────────────────

# URL base de la API de partidos y pagos (sin barra final es válido también).
# Ejemplo para desarrollo local con emulador Android apuntando al host:
#   API_BASE_URL=http://10.0.2.2:8080/api/v1/
# Ejemplo para API pública:
#   API_BASE_URL=https://api.tuservidor.com/v1/
API_BASE_URL=https://placeholder.example.com/

# SDK path (Android Studio lo completa automáticamente al abrir el proyecto).
# sdk.dir=/ruta/al/android/sdk
